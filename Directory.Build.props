<Project>

  <Import Project="$(MSBuildThisFileDirectory)GamePath.props" Condition="Exists('$(MSBuildThisFileDirectory)GamePath.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' And '$(STELLARDRIVE_DIR)' != ''">$(STELLARDRIVE_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo</GameDir>
    <GameManagedDir>$(GameDir)\StellarDrive_Data\Managed</GameManagedDir>
    <MelonLoaderDir>$(GameDir)\MelonLoader\net35</MelonLoaderDir>
    <GameModsDir>$(GameDir)\Mods</GameModsDir>

    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(MelonLoaderDir)\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MelonLoaderDir)\0Harmony.dll" Private="false" />

    <GameAssembly Include="$(GameManagedDir)\*.dll"
                  Exclude="$(GameManagedDir)\mscorlib.dll;$(GameManagedDir)\netstandard.dll;$(GameManagedDir)\System*.dll;$(GameManagedDir)\Mono.*.dll;$(GameManagedDir)\Microsoft.*.dll" />
    <Reference Include="@(GameAssembly)" Private="false" />
  </ItemGroup>
</Project>
